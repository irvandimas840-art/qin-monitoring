rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya izinkan akses ke dokumen data sampling aplikasi ini.
    // Saat ini dibuka bebas (tanpa login Firebase) karena aplikasi
    // memakai login sederhana sendiri, bukan Firebase Auth.
    // Rekomendasi: tambahkan Firebase Auth nanti lalu ganti "if true"
    // menjadi "if request.auth != null" supaya hanya user yang login
    // yang bisa baca/tulis.
    match /app_data/{document} {
      allow read, write: if true;
    }

    // Tolak semua path lain secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
